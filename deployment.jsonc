{
  // Cloudflare account that owns every Worker and provisioned resource.
  "accountId": "68771a7a9aead6d6699483ef609324ae",

  // null derives the public origin from workers.router.route.customDomain.
  "publicBaseUrl": null,

  // Worker names are permanent service identities for the Nimbus Labs workshop
  // deployment. Renaming Workshop, Context, or Scheduler strands their Durable
  // Object data; do not rename.
  "workers": {
    "router": {
      "name": "nimbus-labs-os",
      "route": { "customDomain": "os.nimbuslabs.io" }
    },
    "workshop": { "name": "nimbus-labs-os-workshop" },
    "context": { "name": "nimbus-labs-os-context" },
    "scheduler": { "name": "nimbus-labs-os-scheduler" },
    "websearch": { "name": "nimbus-labs-os-websearch" },
    "customGatekeeper": { "name": "nimbus-labs-os-gk-custom" },
    "errorReporter": { "name": "nimbus-labs-os-errors" }
  },

  "gatekeepers": {},

  // Self-hosted Access application protecting os.nimbuslabs.io; One-time PIN
  // sign-in. "admins" gates /admin.
  "access": {
    "issuer": "https://nimbus-labs.cloudflareaccess.com",
    "audience": "c58a0414817efe1f68277fd2c893dd1b4540e4b85a40242cb36a3a40911b81ce",
    "admins": ["tuy@cloudflare.com"]
  },

  // Model catalog served through Cloudflare AI Gateway. The Workshop reaches
  // the gateway over its WORKERS_AI binding, pre-authenticated inside this
  // account, so no API token is needed. "cloudflare" is Workers AI: workshop
  // attendees use the shared catalog instead of supplying their own keys.
  // Reference: docs/customization.md#ai-models
  "aiGateway": {
    "enabled": true,
    "name": "default",
    "accountId": null,
    "providers": ["cloudflare"]
  },

  "context": {
    // Pinned literal so the Context isolation boundary stays on the original
    // public origin even if the route ever changes.
    "sharingDomain": "https://os.nimbuslabs.io",

    // Existing namespace from the initial deployment; adopted, not provisioned.
    "kvNamespaceId": "cb705e5696fd4612abe3de93cb2c53e6"
  },

  // Workshop does not use the example custom integration.
  "customGatekeeper": {
    "enabled": false,
    "name": "Nimbus Labs",
    "message": "Use only the capabilities provided for the Nimbus Labs workshop."
  },

  "errorReporting": {
    "enabled": true,
    "environment": "workshop",
    "release": null
  },

  // Existing storage from the initial deployment; adopted, not provisioned.
  "resources": {
    "blueprintsKvNamespaceId": "a5ca024e65ab402486ecd9bed0dff69c",
    "avatarsKvNamespaceId": "d9fbe0dcf0b84750b94c45ef879171d3",
    "blueprintContentBucket": "nimbus-labs-os-workshop-blueprint-content"
  },

  "observability": {
    "enabled": true,
    "headSamplingRate": 1,
    "logs": { "invocationLogs": false },
    "traces": { "enabled": false, "headSamplingRate": 0.1 }
  }
}
